generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  idUsuario    Int          @id @default(autoincrement())
  nombre       String       @db.VarChar(120)
  email        String       @unique @db.VarChar(180)
  passwordHash String       @db.VarChar(255)
  resetPasswordTokenHash String? @db.VarChar(255)
  resetPasswordExpiresAt DateTime?
  activo       Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  roles        UsuarioRol[]
  permisosDirectos UsuarioPermiso[]
  ventas       Venta[]
  compras      Compra[]

  @@map("usuarios")
}

model Producto {
  idProducto   Int                @id @default(autoincrement())
  nombre       String             @db.VarChar(180)
  slug         String             @unique @db.VarChar(200)
  sku          String             @unique @db.VarChar(120)
  descripcion  String?            @db.Text
  tipo         Tipo               @map("tipoProducto")
  disponibilidad Disponibilidad   @default(Disponible) @map("estado")
  precio       Decimal            @db.Decimal(10, 2)
  costo        Decimal            @db.Decimal(10, 2)
  activo       Boolean            @default(true)
  color        String?            @db.VarChar(80)
  talla        String?            @db.VarChar(40)
  tono         String?            @db.VarChar(80)
  material     String?            @db.VarChar(120)
  idMarca      Int
  marca        Marca              @relation(fields: [idMarca], references: [idMarca], onDelete: Restrict)
  categorias   ProductoCategoria[]
  imagenes     ProductoImagen[]
  inventarios  Inventario[]
  ventasDetalle VentaDetalle[]
  comprasDetalle CompraDetalle[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([idMarca])

  @@map("productos")
}

model Marca {
  idMarca      Int        @id @default(autoincrement())
  nombre       String     @unique @db.VarChar(120)
  slug         String     @unique @db.VarChar(140)
  descripcion  String?    @db.VarChar(255)
  activo       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  productos    Producto[]

  @@map("marcas")
}

model Categoria {
  idCategoria  Int                @id @default(autoincrement())
  nombre       String             @unique @db.VarChar(120)
  slug         String             @unique @db.VarChar(140)
  descripcion  String?            @db.VarChar(255)
  activo       Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  productos    ProductoCategoria[]

  @@map("categorias")
}

model Ciudad {
  idCiudad    Int       @id @default(autoincrement())
  nombre      String    @unique @db.VarChar(140)
  estado      String    @default("Chiapas") @db.VarChar(80)
  activo      Boolean   @default(true)
  colonias    Colonia[]
  clientes    Cliente[]
  sucursales  Sucursal[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("ciudades")
}

model Colonia {
  idColonia     Int      @id @default(autoincrement())
  nombre        String   @db.VarChar(160)
  codigoPostal  String   @db.VarChar(10)
  idCiudad      Int
  ciudad        Ciudad   @relation(fields: [idCiudad], references: [idCiudad], onDelete: Cascade)
  clientes      Cliente[]
  sucursales    Sucursal[]
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([idCiudad])
  @@unique([idCiudad, nombre, codigoPostal])
  @@map("colonias")
}

model Cliente {
  idCliente        Int       @id @default(autoincrement())
  nombre           String    @db.VarChar(120)
  apellidos        String    @db.VarChar(180)
  email            String?   @unique @db.VarChar(180)
  telefono         String    @db.VarChar(20)
  fechaNacimiento  DateTime?
  genero           Genero?
  direccion        String?   @db.VarChar(255)
  numeroExterior   String?   @db.VarChar(20)
  numeroInterior   String?   @db.VarChar(20)
  referencias      String?   @db.VarChar(255)
  codigoPostal     String?   @db.VarChar(10)
  idCiudad         Int?
  idColonia        Int?
  ciudad           Ciudad?   @relation(fields: [idCiudad], references: [idCiudad], onDelete: SetNull)
  colonia          Colonia?  @relation(fields: [idColonia], references: [idColonia], onDelete: SetNull)
  activo           Boolean   @default(true)
  ventas           Venta[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([telefono])
  @@index([idCiudad])
  @@index([idColonia])
  @@map("clientes")
}

model Proveedor {
  idProveedor     Int       @id @default(autoincrement())
  nombre          String    @unique @db.VarChar(160)
  contactoNombre  String?   @db.VarChar(140)
  telefono        String?   @db.VarChar(20)
  email           String?   @db.VarChar(180)
  direccion       String?   @db.VarChar(255)
  activo          Boolean   @default(true)
  compras         Compra[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("proveedores")
}

model Sucursal {
  idSucursal      Int       @id @default(autoincrement())
  nombre          String    @unique @db.VarChar(140)
  telefono        String    @db.VarChar(20)
  email           String?   @db.VarChar(180)
  encargado       String?   @db.VarChar(140)
  direccion       String    @db.VarChar(255)
  numeroExterior  String?   @db.VarChar(20)
  numeroInterior  String?   @db.VarChar(20)
  referencias     String?   @db.VarChar(255)
  codigoPostal    String?   @db.VarChar(10)
  idCiudad        Int?
  idColonia       Int?
  ciudad          Ciudad?   @relation(fields: [idCiudad], references: [idCiudad], onDelete: SetNull)
  colonia         Colonia?  @relation(fields: [idColonia], references: [idColonia], onDelete: SetNull)
  activo          Boolean   @default(true)
  almacenes       Almacen[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([idCiudad])
  @@index([idColonia])
  @@map("sucursales")
}

model Almacen {
  idAlmacen           Int       @id @default(autoincrement())
  idSucursal          Int
  nombre              String    @db.VarChar(140)
  activo              Boolean   @default(true)
  sucursal            Sucursal  @relation(fields: [idSucursal], references: [idSucursal], onDelete: Cascade)
  inventarios         Inventario[]
  ventas              Venta[]
  compras             Compra[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([idSucursal])
  @@unique([idSucursal, nombre])
  @@map("almacenes")
}

model Inventario {
  idInventario  Int       @id @default(autoincrement())
  idAlmacen     Int
  idProducto    Int
  stockActual   Int       @default(0)
  almacen       Almacen   @relation(fields: [idAlmacen], references: [idAlmacen], onDelete: Cascade)
  producto      Producto  @relation(fields: [idProducto], references: [idProducto], onDelete: Restrict)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([idAlmacen])
  @@index([idProducto])
  @@unique([idAlmacen, idProducto])
  @@map("almacen_tiene_producto")
}

model Venta {
  idVenta      Int           @id @default(autoincrement())
  folio        String        @unique @db.VarChar(40)
  idCliente    Int
  idUsuario    Int
  idAlmacen    Int
  tipoPago     TipoPagoVenta
  estado       EstadoVenta   @default(pendiente)
  subtotal     Decimal       @db.Decimal(12, 2)
  total        Decimal       @db.Decimal(12, 2)
  montoPagado  Decimal       @default(0) @db.Decimal(12, 2)
  cambio       Decimal       @default(0) @db.Decimal(12, 2)
  cliente      Cliente       @relation(fields: [idCliente], references: [idCliente], onDelete: Restrict)
  usuario      User          @relation(fields: [idUsuario], references: [idUsuario], onDelete: Restrict)
  almacen      Almacen       @relation(fields: [idAlmacen], references: [idAlmacen], onDelete: Restrict)
  detalles     VentaDetalle[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([idCliente])
  @@index([idUsuario])
  @@index([idAlmacen])
  @@index([estado])
  @@map("ventas")
}

model VentaDetalle {
  idVentaDetalle Int      @id @default(autoincrement())
  idVenta        Int
  idProducto     Int
  cantidad       Int
  precioUnitario Decimal  @db.Decimal(10, 2)
  subtotal       Decimal  @db.Decimal(12, 2)
  venta          Venta    @relation(fields: [idVenta], references: [idVenta], onDelete: Cascade)
  producto       Producto @relation(fields: [idProducto], references: [idProducto], onDelete: Restrict)
  createdAt      DateTime @default(now())

  @@index([idVenta])
  @@index([idProducto])
  @@map("venta_tiene_producto")
}

model Compra {
  idCompra      Int            @id @default(autoincrement())
  folio         String         @unique @db.VarChar(40)
  idProveedor   Int
  idUsuario     Int
  idAlmacen     Int
  estado        EstadoCompra   @default(completada)
  observaciones String?        @db.VarChar(255)
  subtotal      Decimal        @db.Decimal(12, 2)
  total         Decimal        @db.Decimal(12, 2)
  proveedor     Proveedor      @relation(fields: [idProveedor], references: [idProveedor], onDelete: Restrict)
  usuario       User           @relation(fields: [idUsuario], references: [idUsuario], onDelete: Restrict)
  almacen       Almacen        @relation(fields: [idAlmacen], references: [idAlmacen], onDelete: Restrict)
  detalles      CompraDetalle[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([idProveedor])
  @@index([idUsuario])
  @@index([idAlmacen])
  @@index([estado])
  @@map("compras")
}

model CompraDetalle {
  idCompraDetalle Int      @id @default(autoincrement())
  idCompra        Int
  idProducto      Int
  cantidad        Int
  costoUnitario   Decimal  @db.Decimal(10, 2)
  subtotal        Decimal  @db.Decimal(12, 2)
  compra          Compra   @relation(fields: [idCompra], references: [idCompra], onDelete: Cascade)
  producto        Producto @relation(fields: [idProducto], references: [idProducto], onDelete: Restrict)
  createdAt       DateTime @default(now())

  @@index([idCompra])
  @@index([idProducto])
  @@map("compra_tiene_producto")
}

model ProductoCategoria {
  idProducto   Int
  idCategoria  Int
  createdAt    DateTime   @default(now())
  producto     Producto   @relation(fields: [idProducto], references: [idProducto], onDelete: Cascade)
  categoria    Categoria  @relation(fields: [idCategoria], references: [idCategoria], onDelete: Cascade)

  @@id([idProducto, idCategoria])
  @@index([idCategoria])
  @@map("producto_tiene_categoria")
}

model ProductoImagen {
  idImagen     Int       @id @default(autoincrement())
  idProducto   Int
  url          String    @db.VarChar(255)
  alt          String?   @db.VarChar(180)
  orden        Int       @default(0)
  principal    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  producto     Producto  @relation(fields: [idProducto], references: [idProducto], onDelete: Cascade)

  @@index([idProducto])
  @@map("producto_tiene_imagen")
}

model Rol {
  idRol       Int          @id @default(autoincrement())
  nombre      String       @unique @db.VarChar(100)
  descripcion String?      @db.VarChar(255)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  usuarios    UsuarioRol[]
  permisos    RolPermiso[]

  @@map("roles")
}

model Permiso {
  idPermiso   Int          @id @default(autoincrement())
  nombre      String       @unique @db.VarChar(120)
  descripcion String?      @db.VarChar(255)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  roles       RolPermiso[]
  usuarios    UsuarioPermiso[]

  @@map("permisos")
}

model UsuarioRol {
  idUsuario  Int
  idRol      Int
  createdAt   DateTime @default(now())
  user       User     @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade)
  rol        Rol      @relation(fields: [idRol], references: [idRol], onDelete: Cascade)

  @@id([idUsuario, idRol])
  @@index([idRol])
  @@map("usuario_tiene_rol")
}

model RolPermiso {
  idRol      Int
  idPermiso  Int
  createdAt   DateTime @default(now())
  rol        Rol      @relation(fields: [idRol], references: [idRol], onDelete: Cascade)
  permiso    Permiso  @relation(fields: [idPermiso], references: [idPermiso], onDelete: Cascade)

  @@id([idRol, idPermiso])
  @@index([idPermiso])
  @@map("rol_tiene_permiso")
}

model UsuarioPermiso {
  idUsuario  Int
  idPermiso  Int
  createdAt   DateTime @default(now())
  user       User     @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade)
  permiso    Permiso  @relation(fields: [idPermiso], references: [idPermiso], onDelete: Cascade)

  @@id([idUsuario, idPermiso])
  @@index([idPermiso])
  @@map("usuario_tiene_permiso")
}

enum Tipo {
  Ropa       @map("ROPA")
  Maquillaje @map("MAQUILLAJE")
  Accesorios @map("HOGAR")
  Otros      @map("OTROS")
}

enum Disponibilidad {
  Disponible    @map("PUBLICADO")
  Pausado       @map("BORRADOR")
  Descontinuado @map("DESCONTINUADO")
}

enum Genero {
  Masculino @map("MASCULINO")
  Femenino  @map("FEMENINO")
}

enum EstadoVenta {
  pendiente
  pagado
  cancelado
}

enum TipoPagoVenta {
  efectivo
  transferencia
}

enum EstadoCompra {
  completada
  cancelada
}
