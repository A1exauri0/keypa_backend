generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  idUsuario    Int          @id @default(autoincrement())
  nombre       String       @db.VarChar(120)
  email        String       @unique @db.VarChar(180)
  passwordHash String       @db.VarChar(255)
  resetPasswordTokenHash String? @db.VarChar(255)
  resetPasswordExpiresAt DateTime?
  activo       Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  roles        UsuarioRol[]
  permisosDirectos UsuarioPermiso[]

  @@map("usuarios")
}

model Producto {
  idProducto   Int                @id @default(autoincrement())
  nombre       String             @db.VarChar(180)
  slug         String             @unique @db.VarChar(200)
  sku          String             @unique @db.VarChar(120)
  descripcion  String?            @db.Text
  tipo         Tipo               @map("tipoProducto")
  disponibilidad Disponibilidad   @default(Disponible) @map("estado")
  precio       Decimal            @db.Decimal(10, 2)
  costo        Decimal            @db.Decimal(10, 2)
  activo       Boolean            @default(true)
  color        String?            @db.VarChar(80)
  talla        String?            @db.VarChar(40)
  tono         String?            @db.VarChar(80)
  material     String?            @db.VarChar(120)
  idMarca      Int
  marca        Marca              @relation(fields: [idMarca], references: [idMarca], onDelete: Restrict)
  categorias   ProductoCategoria[]
  imagenes     ProductoImagen[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([idMarca])

  @@map("productos")
}

model Marca {
  idMarca      Int        @id @default(autoincrement())
  nombre       String     @unique @db.VarChar(120)
  slug         String     @unique @db.VarChar(140)
  descripcion  String?    @db.VarChar(255)
  activo       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  productos    Producto[]

  @@map("marcas")
}

model Categoria {
  idCategoria  Int                @id @default(autoincrement())
  nombre       String             @unique @db.VarChar(120)
  slug         String             @unique @db.VarChar(140)
  descripcion  String?            @db.VarChar(255)
  activo       Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  productos    ProductoCategoria[]

  @@map("categorias")
}

model ProductoCategoria {
  idProducto   Int
  idCategoria  Int
  createdAt    DateTime   @default(now())
  producto     Producto   @relation(fields: [idProducto], references: [idProducto], onDelete: Cascade)
  categoria    Categoria  @relation(fields: [idCategoria], references: [idCategoria], onDelete: Cascade)

  @@id([idProducto, idCategoria])
  @@index([idCategoria])
  @@map("producto_tiene_categoria")
}

model ProductoImagen {
  idImagen     Int       @id @default(autoincrement())
  idProducto   Int
  url          String    @db.VarChar(255)
  alt          String?   @db.VarChar(180)
  orden        Int       @default(0)
  principal    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  producto     Producto  @relation(fields: [idProducto], references: [idProducto], onDelete: Cascade)

  @@index([idProducto])
  @@map("producto_tiene_imagen")
}

model Rol {
  idRol       Int          @id @default(autoincrement())
  nombre      String       @unique @db.VarChar(100)
  descripcion String?      @db.VarChar(255)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  usuarios    UsuarioRol[]
  permisos    RolPermiso[]

  @@map("roles")
}

model Permiso {
  idPermiso   Int          @id @default(autoincrement())
  nombre      String       @unique @db.VarChar(120)
  descripcion String?      @db.VarChar(255)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  roles       RolPermiso[]
  usuarios    UsuarioPermiso[]

  @@map("permisos")
}

model UsuarioRol {
  idUsuario  Int
  idRol      Int
  createdAt   DateTime @default(now())
  user       User     @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade)
  rol        Rol      @relation(fields: [idRol], references: [idRol], onDelete: Cascade)

  @@id([idUsuario, idRol])
  @@index([idRol])
  @@map("usuario_tiene_rol")
}

model RolPermiso {
  idRol      Int
  idPermiso  Int
  createdAt   DateTime @default(now())
  rol        Rol      @relation(fields: [idRol], references: [idRol], onDelete: Cascade)
  permiso    Permiso  @relation(fields: [idPermiso], references: [idPermiso], onDelete: Cascade)

  @@id([idRol, idPermiso])
  @@index([idPermiso])
  @@map("rol_tiene_permiso")
}

model UsuarioPermiso {
  idUsuario  Int
  idPermiso  Int
  createdAt   DateTime @default(now())
  user       User     @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade)
  permiso    Permiso  @relation(fields: [idPermiso], references: [idPermiso], onDelete: Cascade)

  @@id([idUsuario, idPermiso])
  @@index([idPermiso])
  @@map("usuario_tiene_permiso")
}

enum Tipo {
  Ropa       @map("ROPA")
  Maquillaje @map("MAQUILLAJE")
  Accesorios @map("HOGAR")
  Otros      @map("OTROS")
}

enum Disponibilidad {
  Disponible    @map("PUBLICADO")
  Pausado       @map("BORRADOR")
  Descontinuado @map("DESCONTINUADO")
}
